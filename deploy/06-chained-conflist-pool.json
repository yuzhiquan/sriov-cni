{
  "_comment": "chained mode + pool: no Device Plugin needed; the CNI allocates VFs itself from those under ens1f0. Trade-off: the scheduler cannot see VF counts, so when the pool is exhausted Pods fail at CNI ADD.",
  "name": "k8s-pod-network",
  "cniVersion": "1.0.0",
  "plugins": [
    {
      "type": "calico",
      "datastore_type": "kubernetes",
      "ipam": { "type": "calico-ipam" },
      "policy": { "type": "k8s" },
      "kubernetes": { "kubeconfig": "/etc/cni/net.d/calico-kubeconfig" }
    },
    {
      "type": "sriov",
      "mode": "chained",
      "vfAllocator": "pool",
      "logLevel": "info",
      "logFile": "/var/log/sriov-cni.log",

      "kubernetes": {
        "apiServer": "https://10.96.0.1:443",
        "tokenFile": "/etc/cni/net.d/sriov.d/token",
        "caFile": "/etc/cni/net.d/sriov.d/ca.crt"
      },
      "pool": {
        "pfNames": ["ens1f0"],
        "stateDir": "/var/lib/cni/sriov/pool"
      },

      "networks": {
        "vlan1000": {
          "vlan": 1000,
          "spoofchk": "off",
          "ipam": { "type": "host-local", "subnet": "192.168.100.0/24" }
        }
      }
    }
  ]
}
